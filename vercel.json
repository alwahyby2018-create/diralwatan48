{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/proxy.mjs": {
      "maxDuration": 60,
      "includeFiles": "assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/proxy?__path=$1"
    }
  ]
}